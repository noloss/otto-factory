# Copy this file to .env and fill in the values.

# Required: the GitHub repository where issues and PRs will be created.
# All of these formats are accepted — paste the URL straight from your browser if you like:
#   GITHUB_REPO=your-username/your-repo
#   GITHUB_REPO=/your-username/your-repo
#   GITHUB_REPO=https://github.com/your-username/your-repo
GITHUB_REPO=your-username/your-repo

# Path to the local clone of the target project (where coder will write code)
# Defaults to the current working directory if not set.
TARGET_DIR=/path/to/your/project

# Shell command used to run the test suite after each coder attempt.
# Leave blank to skip automated testing.
# Examples: "npm test", "pytest", "go test ./...", "cargo test"
TEST_COMMAND=npm test

# Directory/glob that the coder stages with `git add` before committing.
# Use a path relative to TARGET_DIR. Default: "src"
SOURCE_GLOB=src

# Shell initialisation command prepended to TEST_COMMAND before running tests.
#
# otto-factory runs TEST_COMMAND in a non-interactive bash shell, which does NOT
# source your ~/.bashrc or ~/.zshrc. If your test runner (node, python, ruby, etc.)
# is managed by a version manager, you need to initialise it here so it is on PATH.
#
# How to find the right value:
#   1. Run `which npm` (or `which python`, `which node`, etc.) in your terminal.
#   2. If the path contains ".nvm", ".asdf", ".pyenv", or similar, you need SHELL_INIT.
#   3. Check your ~/.bashrc or ~/.zshrc for the line that loads your version manager
#      and paste it here.
#
# Common examples:
#   SHELL_INIT=source ~/.nvm/nvm.sh && nvm use node --silent   # nvm (Node.js — "node" alias is safer than "default" which may not be set)
#   SHELL_INIT=source ~/.asdf/asdf.sh                   # asdf (multi-language)
#   SHELL_INIT=source ~/.rvm/scripts/rvm                # rvm (Ruby)
#
# If `which npm` (or your tool) returns a standard path like /usr/local/bin/npm,
# you don't need this — leave it blank.
#
# Windows users: otto-factory is designed for Mac/Linux. On Windows, use WSL
# (Windows Subsystem for Linux) and follow the Mac/Linux instructions inside it.
# SHELL_INIT=

# Paths to the gh and claude CLI binaries (default: found on PATH)
# GH_BIN=gh
# CLAUDE_BIN=claude

# Timeout in seconds for the coder agent (default: 600)
# CODER_TIMEOUT=600

# Maximum retry attempts per issue (default: 3)
# MAX_ATTEMPTS=3
